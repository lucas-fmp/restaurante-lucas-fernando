{
  "name": "marmitatech-pro",
  "version": "1.0.0",
  "description": "Sistema de Gestão de Marmitas - MySQL Version",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node index.js & npm run dev:css",
    "build:css": "tailwindcss -i ./public/css/tailwind-input.css -o ./public/css/style.css",
    "dev:css": "tailwindcss -i ./public/css/tailwind-input.css -o ./public/css/style.css --watch",
    "test": "jest --forceExit",
    "test:coverage": "jest --coverage --forceExit"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.3.1",
    "body-parser": "1.18.3",
    "ejs": "3.1.6",
    "express": "5.2.1",
    "express-ejs-layouts": "^2.5.1",
    "express-session": "^1.19.0",
    "multer": "^2.2.0",
    "mysql2": "3.9.1",
    "tailwindcss": "^4.3.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "index.js",
      "routes/**/*.js",
      "config/**/*.js"
    ],
    "coverageReporters": [
      "lcov",
      "text",
      "text-summary"
    ],
    "coverageDirectory": "coverage"
  }
}
