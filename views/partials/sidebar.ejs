<aside id="sidebar" class="fixed left-0 top-0 z-50 h-screen w-72 border-r border-border bg-card transition-transform duration-300 ease-in-out -translate-x-full lg:translate-x-0">
    <div class="flex h-full flex-col">
        <!-- Logo -->
        <div class="flex h-16 items-center justify-between border-b border-border px-4">
            <a href="/dashboard" class="flex items-center gap-3">
                <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-primary to-accent">
                    <i data-lucide="chef-hat" class="h-6 w-6 text-white"></i>
                </div>
                <div>
                    <h1 class="text-lg font-semibold text-foreground">Restaurante</h1>
                    <p class="text-xs text-muted-foreground">Lucas Fernando</p>
                </div>
            </a>
            <button id="close-sidebar-btn" class="lg:hidden text-muted-foreground hover:text-foreground">
                <i data-lucide="x" class="h-5 w-5"></i>
            </button>
        </div>

        <!-- Navigation -->
        <nav class="flex-1 space-y-1 p-4">
            <% const menuItems = [
                { icon: 'layout-dashboard', label: 'Dashboard', path: '/dashboard' },
                { icon: 'shopping-bag', label: 'Pedidos', path: '/orders' },
                { icon: 'utensils-crossed', label: 'Cardápio', path: '/menu' },
                { icon: 'flame', label: 'Cozinha', path: '/kanban' },
                { icon: 'bar-chart-3', label: 'Relatórios', path: '/reports' },
                { icon: 'settings', label: 'Configurações', path: '/settings' }
            ]; %>
            
            <% menuItems.forEach(item => { %>
                <% const isActive = path.startsWith(item.path); %>
                <a href="<%= item.path %>" class="flex items-center gap-3 rounded-xl px-4 py-3 transition-all <%= isActive ? 'bg-gradient-to-r from-primary to-accent text-white shadow-lg shadow-primary/20' : 'text-muted-foreground hover:text-foreground hover:bg-accent/10' %>">
                    <i data-lucide="<%= item.icon %>" class="h-5 w-5 shrink-0"></i>
                    <span class="text-sm font-medium"><%= item.label %></span>
                </a>
            <% }) %>
        </nav>

        <!-- Footer -->
        <div class="border-t border-border p-4">
            <div class="rounded-xl bg-gradient-to-br from-primary/10 to-accent/10 p-4">
                <p class="text-xs font-medium text-foreground">Usuário Logado</p>
                <p class="text-xs text-muted-foreground mt-1 truncate"><%= user ? user.username : 'Convidado' %></p>
            </div>
        </div>
    </div>
</aside>
