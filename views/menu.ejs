<div class="space-y-8">
    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
        <div>
            <h1 class="text-3xl font-bold mb-2">Cardápio</h1>
            <p class="text-muted-foreground">Gerencie os produtos do seu restaurante</p>
        </div>
        <button onclick="openModal()" class="inline-flex items-center justify-center whitespace-nowrap text-sm font-medium transition-colors bg-primary text-primary-foreground hover:bg-primary/90 h-10 px-4 py-2 rounded-xl gap-2">
            <i data-lucide="plus" class="w-4 h-4"></i> Adicionar Item
        </button>
    </div>

    <!-- Products Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
        <% items.forEach(item => { %>
            <div class="rounded-2xl overflow-hidden border border-border/50 hover:border-primary/50 transition-all bg-card shadow group">
                <div class="relative aspect-video overflow-hidden bg-muted flex items-center justify-center">
                    <% if (item.image_url) { %>
                        <img src="<%= item.image_url %>" alt="<%= item.name %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300">
                    <% } else { %>
                        <i data-lucide="image" class="w-12 h-12 text-muted-foreground opacity-50"></i>
                    <% } %>
                </div>
                <div class="p-5 space-y-4">
                    <div>
                        <div class="flex items-start justify-between gap-2 mb-2">
                            <h3 class="font-bold text-lg line-clamp-1"><%= item.name %></h3>
                            <span class="text-xs bg-secondary text-secondary-foreground px-2 py-1 rounded-md"><%= item.category || 'Marmita' %></span>
                        </div>
                    </div>
                    
                    <div class="flex items-center justify-between">
                        <div>
                            <div class="text-xs text-muted-foreground mb-1">Preço</div>
                            <div class="text-2xl font-bold text-primary">R$ <%= parseFloat(item.price).toFixed(2) %></div>
                        </div>
                        <div class="flex gap-2">
                            <button onclick="openModal({id: '<%= item.id %>', name: '<%= item.name %>', price: '<%= item.price %>', category: '<%= item.category %>', image_url: '<%= item.image_url || '' %>'})" class="p-2 hover:bg-accent/10 rounded-xl text-foreground">
                                <i data-lucide="edit" class="w-4 h-4"></i>
                            </button>
                            <button onclick="deleteItem('<%= item.id %>')" class="p-2 hover:bg-destructive/10 rounded-xl text-destructive hover:text-destructive">
                                <i data-lucide="trash-2" class="w-4 h-4"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        <% }) %>
    </div>
</div>

<!-- Modal Adicionar/Editar -->
<div id="product-modal" class="fixed inset-0 z-50 flex items-center justify-center hidden">
    <div class="fixed inset-0 bg-black/50 backdrop-blur-sm" onclick="closeModal()"></div>
    <div class="relative bg-card rounded-2xl shadow-lg w-full max-w-lg mx-4 p-6 border border-border">
        <h2 id="modal-title" class="text-xl font-bold mb-1">Adicionar Item</h2>
        <p class="text-sm text-muted-foreground mb-6">Preencha os dados do produto.</p>
        
        <form id="product-form" action="/api/items" method="POST" enctype="multipart/form-data">
            <input type="hidden" name="id" id="product_id">
            <div class="space-y-4">
                <div class="space-y-2">
                    <label class="text-sm font-medium">Nome</label>
                    <input type="text" name="name" id="product_name" required class="w-full h-10 rounded-xl border border-input bg-input-background px-3 text-sm focus:outline-none focus:ring-2 focus:ring-ring">
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div class="space-y-2">
                        <label class="text-sm font-medium">Preço (R$)</label>
                        <input type="number" step="0.01" name="price" id="product_price" required class="w-full h-10 rounded-xl border border-input bg-input-background px-3 text-sm focus:outline-none focus:ring-2 focus:ring-ring">
                    </div>
                    <div class="space-y-2">
                        <label class="text-sm font-medium">Categoria</label>
                        <select name="category" id="product_category" class="w-full h-10 rounded-xl border border-input bg-input-background px-3 text-sm focus:outline-none focus:ring-2 focus:ring-ring">
                            <option value="Base">Base</option>
                            <option value="Proteína">Proteína</option>
                            <option value="Bebida">Bebida</option>
                            <option value="Sobremesa">Sobremesa</option>
                        </select>
                    </div>
                </div>
                <div class="space-y-2">
                    <label class="text-sm font-medium">Imagem</label>
                    <input type="file" name="image" accept="image/*" class="w-full text-sm">
                </div>
            </div>
            
            <div class="flex justify-end gap-3 mt-6">
                <button type="button" onclick="closeModal()" class="px-4 py-2 rounded-xl text-sm font-medium border border-border hover:bg-muted">Cancelar</button>
                <button type="submit" class="px-4 py-2 rounded-xl text-sm font-medium bg-primary text-primary-foreground hover:bg-primary/90">Salvar</button>
            </div>
        </form>
    </div>
</div>

<script>
    function openModal(data = null) {
        document.getElementById('product-modal').classList.remove('hidden');
        if (data) {
            document.getElementById('modal-title').innerText = 'Editar Item';
            document.getElementById('product_id').value = data.id;
            document.getElementById('product_name').value = data.name;
            document.getElementById('product_price').value = data.price;
            document.getElementById('product_category').value = data.category;
            // API route for editing can be /api/items/:id via POST/PUT
            document.getElementById('product-form').action = '/api/items/' + data.id;
        } else {
            document.getElementById('modal-title').innerText = 'Adicionar Item';
            document.getElementById('product-form').reset();
            document.getElementById('product_id').value = '';
            document.getElementById('product-form').action = '/api/items';
        }
    }

    function closeModal() {
        document.getElementById('product-modal').classList.add('hidden');
    }

    function deleteItem(id) {
        if(confirm('Tem certeza que deseja excluir?')) {
            fetch('/api/items/' + id, { method: 'DELETE' })
            .then(() => window.location.reload());
        }
    }
</script>
