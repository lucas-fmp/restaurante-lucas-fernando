<!DOCTYPE html>
<html>
<head>
    <title>MarmitaTech - Dashboard</title>
    <style>
        * { box-sizing: border-box; }
        body {
            font-family: sans-serif;
            background: #f4f4f4;
            margin: 0;
            padding: 20px;
        }
        .container {
            max-width: 1200px;
            margin: 0 auto;
            background: white;
            padding: 30px;
            border-radius: 10px;
            box-shadow: 0 0 15px rgba(0,0,0,0.1);
        }
        h1 {
            text-align: center;
            color: #333;
            margin-bottom: 30px;
        }
        .grid {
            display: flex;
            gap: 20px;
            flex-wrap: wrap;
        }
        .card {
            flex: 1;
            min-width: 300px;
            border: 1px solid #eee;
            padding: 20px;
            border-radius: 8px;
            background: #fafafa;
        }
        .card h3 {
            margin-top: 0;
            color: #333;
        }
        input, select {
            width: 100%;
            padding: 9px 10px;
            margin-bottom: 12px;
            border-radius: 5px;
            border: 1px solid #ccc;
            font-size: 14px;
        }
        .checkbox-group {
            margin-bottom: 12px;
        }
        .checkbox-group label {
            display: block;
            margin-bottom: 5px;
        }
        .btn {
            width: 100%;
            padding: 10px;
            border: none;
            border-radius: 5px;
            background: #ff6600;
            color: white;
            font-weight: bold;
            cursor: pointer;
            font-size: 14px;
        }
        .btn:hover { background: #e65c00; }
        ul {
            list-style: none;
            padding: 0;
        }
        li {
            padding: 8px 0;
            border-bottom: 1px solid #eee;
        }
        .order-item {
            background: #f9f9f9;
            padding: 10px;
            margin-bottom: 10px;
            border-radius: 5px;
        }
    </style>
</head>
<body>
    <div class="container">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px;">
            <h1 style="margin: 0;">🍽️ MarmitaTech - Dashboard</h1>
            <a href="/kanban" style="background: #ff6600; color: white; padding: 10px 20px; border-radius: 5px; text-decoration: none; font-weight: bold;">📊 Painel Kanban</a>
        </div>
        <div class="grid">
            <div class="card">
                <h3>Novo Item (Ingrediente)</h3>
                <form action="/add-item" method="POST">
                    <input type="text" name="name" placeholder="Nome (Ex: Batata Doce)" required>
                    <input type="text" name="category" placeholder="Categoria (Ex: Carboidrato)">
                    <input type="number" step="0.01" name="price" placeholder="Preço (Ex: 5.00)" required>
                    <button class="btn" type="submit">Cadastrar Item</button>
                </form>
            </div>

            <div class="card">
                <h3>Novo Pedido</h3>
                <form action="/orders" method="POST">
                    <input type="text" name="customer_name" placeholder="Nome do Cliente" required>
                    <div class="checkbox-group">
                        <% items.forEach(item => { %>
                            <label>
                                <input type="checkbox" name="item_ids" value="<%= item.id %>">
                                <%= item.name %> (R$ <%= item.price %>)
                            </label>
                        <% }) %>
                    </div>
                    <button class="btn" type="submit">Criar Pedido</button>
                </form>
            </div>

            <div class="card">
                <h3>Itens Cadastrados</h3>
                <ul>
                    <% items.forEach(item => { %>
                        <li><%= item.name %> (<%= item.category %>) - R$ <%= item.price %></li>
                    <% }) %>
                </ul>
            </div>

            <div class="card">
                <h3>Pedidos Ativos</h3>
                <% if (orders.length === 0) { %>
                    <p>Nenhum pedido ainda.</p>
                <% } else { %>
                    <% orders.forEach(order => { %>
                        <div class="order-item">
                            <strong><%= order.customer_name %></strong> - Status: <%= order.status %><br>
                            Itens: <%= order.item_names || 'Nenhum' %>
                        </div>
                    <% }) %>
                <% } %>
            </div>
        </div>
    </div>
</body>
</html>
