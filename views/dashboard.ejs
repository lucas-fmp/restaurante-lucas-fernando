<!DOCTYPE html>
<html>
<head>
    <title>MarmitaTech - Dashboard</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50">
    <!-- Header -->
    <nav class="bg-white shadow-sm sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex justify-between items-center">
            <div class="flex items-center gap-3">
                <span class="text-2xl">🍽️</span>
                <h1 class="text-2xl font-bold text-gray-800">MarmitaTech</h1>
            </div>
            <div class="flex gap-3">
                <a href="/admin/export" class="bg-green-600 hover:bg-green-700 text-white font-semibold px-6 py-2 rounded-lg transition shadow-md hover:shadow-lg">
                    📥 Baixar Relatório
                </a>
                <a href="/kanban" class="bg-orange-600 hover:bg-orange-700 text-white font-semibold px-6 py-2 rounded-lg transition shadow-md hover:shadow-lg">
                    📊 Painel Kanban
                </a>
            </div>
        </div>
    </nav>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <!-- Title -->
        <div class="mb-8">
            <h2 class="text-3xl font-bold text-gray-800 mb-2">Dashboard Administrativo</h2>
            <p class="text-gray-600">Gerencie itens e crie pedidos para seus clientes</p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            <!-- Card: Novo Item -->
            <div class="lg:col-span-1 bg-white rounded-xl shadow-md overflow-hidden hover:shadow-lg transition">
                <div class="bg-gradient-to-r from-orange-500 to-orange-600 px-6 py-4">
                    <h3 class="text-lg font-bold text-white">➕ Novo Item</h3>
                </div>
                <div class="p-6">
                    <form action="/add-item" method="POST" class="space-y-4">
                        <input type="text" name="name" placeholder="Nome (ex: Arroz Branco)" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-orange-500 transition">
                        <input type="text" name="category" placeholder="Categoria (ex: Base)" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-orange-500 transition">
                        <input type="number" step="0.01" name="price" placeholder="Preço (ex: 5.00)" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-orange-500 transition">
                        <button type="submit" class="w-full bg-orange-600 hover:bg-orange-700 text-white font-semibold py-2 rounded-lg transition transform hover:scale-105">
                            Adicionar Item
                        </button>
                    </form>
                </div>
            </div>

            <!-- Card: Novo Pedido -->
            <div class="lg:col-span-1 bg-white rounded-xl shadow-md overflow-hidden hover:shadow-lg transition">
                <div class="bg-gradient-to-r from-blue-500 to-blue-600 px-6 py-4">
                    <h3 class="text-lg font-bold text-white">📦 Novo Pedido</h3>
                </div>
                <div class="p-6 max-h-96 overflow-y-auto">
                    <form action="/orders" method="POST" class="space-y-4">
                        <input type="text" name="customer_name" placeholder="Nome do Cliente" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 transition">
                        <div class="space-y-2">
                            <p class="text-sm font-semibold text-gray-700">Selecione os itens:</p>
                            <% items.forEach(item => { %>
                                <label class="flex items-center p-2 hover:bg-gray-50 rounded cursor-pointer transition">
                                    <input type="checkbox" name="item_ids" value="<%= item.id %>" class="w-4 h-4 text-blue-600 rounded focus:ring-2 focus:ring-blue-500">
                                    <span class="ml-3 text-sm text-gray-700">
                                        <strong><%= item.name %></strong> - R$ <%= parseFloat(item.price).toFixed(2) %>
                                    </span>
                                </label>
                            <% }) %>
                        </div>
                        <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 rounded-lg transition transform hover:scale-105">
                            Criar Pedido
                        </button>
                    </form>
                </div>
            </div>

            <!-- Card: Itens Cadastrados -->
            <div class="lg:col-span-1 bg-white rounded-xl shadow-md overflow-hidden hover:shadow-lg transition">
                <div class="bg-gradient-to-r from-green-500 to-green-600 px-6 py-4">
                    <h3 class="text-lg font-bold text-white">📋 Itens Cadastrados</h3>
                </div>
                <div class="p-6 max-h-96 overflow-y-auto">
                    <% if (items.length === 0) { %>
                        <p class="text-center text-gray-500 py-8">Nenhum item cadastrado</p>
                    <% } else { %>
                        <div class="space-y-2">
                            <% items.forEach(item => { %>
                                <div class="p-3 bg-gradient-to-r from-gray-50 to-gray-100 rounded-lg border border-gray-200">
                                    <p class="font-semibold text-gray-800"><%= item.name %></p>
                                    <div class="flex justify-between text-sm text-gray-600 mt-1">
                                        <span><%= item.category %></span>
                                        <span class="font-semibold text-green-600">R$ <%= parseFloat(item.price).toFixed(2) %></span>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>

        <!-- Pedidos Recentes -->
        <div class="mt-8 bg-white rounded-xl shadow-md overflow-hidden">
            <div class="bg-gradient-to-r from-purple-500 to-purple-600 px-6 py-4">
                <h3 class="text-lg font-bold text-white">📦 Pedidos Recentes</h3>
            </div>
            <div class="p-6">
                <% if (orders.length === 0) { %>
                    <p class="text-center text-gray-500 py-8">Nenhum pedido realizado ainda</p>
                <% } else { %>
                    <div class="overflow-x-auto">
                        <table class="w-full">
                            <thead class="bg-gray-50 border-b border-gray-200">
                                <tr>
                                    <th class="px-4 py-3 text-left text-sm font-semibold text-gray-700">ID</th>
                                    <th class="px-4 py-3 text-left text-sm font-semibold text-gray-700">Cliente</th>
                                    <th class="px-4 py-3 text-left text-sm font-semibold text-gray-700">Itens</th>
                                    <th class="px-4 py-3 text-left text-sm font-semibold text-gray-700">Status</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-200">
                                <% orders.forEach(order => { %>
                                    <tr class="hover:bg-gray-50 transition">
                                        <td class="px-4 py-3 text-sm text-gray-900 font-semibold">#<%= order.id %></td>
                                        <td class="px-4 py-3 text-sm text-gray-900"><%= order.customer_name %></td>
                                        <td class="px-4 py-3 text-sm text-gray-600"><%= order.item_names || '—' %></td>
                                        <td class="px-4 py-3 text-sm">
                                            <span class="px-3 py-1 rounded-full text-xs font-semibold
                                                <% if (order.status === 'Aberto') { %>
                                                    bg-yellow-100 text-yellow-800
                                                <% } else if (order.status === 'Cozinha') { %>
                                                    bg-blue-100 text-blue-800
                                                <% } else if (order.status === 'Entrega') { %>
                                                    bg-purple-100 text-purple-800
                                                <% } else if (order.status === 'Entregue') { %>
                                                    bg-green-100 text-green-800
                                                <% } %>
                                            ">
                                                <%= order.status %>
                                            </span>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</body>
</html>
