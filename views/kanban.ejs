<!DOCTYPE html>
<html>
<head>
    <title>MarmitaTech - Painel Kanban</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50">
    <!-- Header -->
    <nav class="bg-white shadow-sm sticky top-0 z-50">
        <div class="max-w-full mx-auto px-4 sm:px-6 lg:px-8 py-4 flex justify-between items-center">
            <div class="flex items-center gap-3">
                <span class="text-2xl">🍽️</span>
                <h1 class="text-2xl font-bold text-gray-800">MarmitaTech - Kanban</h1>
            </div>
            <a href="/dashboard" class="bg-gray-600 hover:bg-gray-700 text-white font-semibold px-6 py-2 rounded-lg transition shadow-md hover:shadow-lg">
                ← Dashboard
            </a>
        </div>
    </nav>

    <div class="p-6">
        <div class="mb-8">
            <h2 class="text-3xl font-bold text-gray-800 mb-2">📊 Painel Kanban da Cozinha</h2>
            <p class="text-gray-600">Gerencie o fluxo de produção dos pedidos</p>
        </div>

        <!-- Kanban Board -->
        <div class="flex gap-6 overflow-x-auto pb-4">
            <!-- Coluna: Aberto -->
            <div class="flex-shrink-0 w-80 bg-white rounded-xl shadow-md overflow-hidden">
                <div class="bg-gradient-to-r from-yellow-400 to-yellow-500 px-6 py-4">
                    <h3 class="text-lg font-bold text-white">📋 Aberto</h3>
                </div>
                <div class="p-4 min-h-96 bg-gray-50">
                    <% const abertos = orders.filter(o => o.status === 'Aberto'); %>
                    <% if (abertos.length === 0) { %>
                        <div class="flex items-center justify-center h-full text-gray-400">
                            <p class="text-sm">Nenhum pedido</p>
                        </div>
                    <% } else { %>
                        <div class="space-y-3">
                            <% abertos.forEach(order => { %>
                                <div class="bg-white p-4 rounded-lg border-l-4 border-yellow-400 shadow-sm hover:shadow-md transition" data-order-id="<%= order.id %>">
                                    <div class="font-bold text-gray-800 mb-2"><%= order.customer_name %></div>
                                    <div class="text-xs text-gray-600 mb-3 p-2 bg-gray-50 rounded">
                                        <%= order.item_names %>
                                    </div>
                                    <button onclick="advanceStatus(<%= order.id %>, 'Aberto')" class="w-full bg-yellow-500 hover:bg-yellow-600 text-white font-semibold text-sm py-2 rounded transition transform hover:scale-105">
                                        → Cozinha
                                    </button>
                                </div>
                            <% }) %>
                        </div>
                    <% } %>
                </div>
            </div>

            <!-- Coluna: Cozinha -->
            <div class="flex-shrink-0 w-80 bg-white rounded-xl shadow-md overflow-hidden">
                <div class="bg-gradient-to-r from-blue-400 to-blue-500 px-6 py-4">
                    <h3 class="text-lg font-bold text-white">👨‍🍳 Cozinha</h3>
                </div>
                <div class="p-4 min-h-96 bg-gray-50">
                    <% const cozinha = orders.filter(o => o.status === 'Cozinha'); %>
                    <% if (cozinha.length === 0) { %>
                        <div class="flex items-center justify-center h-full text-gray-400">
                            <p class="text-sm">Nenhum pedido</p>
                        </div>
                    <% } else { %>
                        <div class="space-y-3">
                            <% cozinha.forEach(order => { %>
                                <div class="bg-white p-4 rounded-lg border-l-4 border-blue-400 shadow-sm hover:shadow-md transition" data-order-id="<%= order.id %>">
                                    <div class="font-bold text-gray-800 mb-2"><%= order.customer_name %></div>
                                    <div class="text-xs text-gray-600 mb-3 p-2 bg-gray-50 rounded">
                                        <%= order.item_names %>
                                    </div>
                                    <button onclick="advanceStatus(<%= order.id %>, 'Cozinha')" class="w-full bg-blue-500 hover:bg-blue-600 text-white font-semibold text-sm py-2 rounded transition transform hover:scale-105">
                                        → Entrega
                                    </button>
                                </div>
                            <% }) %>
                        </div>
                    <% } %>
                </div>
            </div>

            <!-- Coluna: Entrega -->
            <div class="flex-shrink-0 w-80 bg-white rounded-xl shadow-md overflow-hidden">
                <div class="bg-gradient-to-r from-purple-400 to-purple-500 px-6 py-4">
                    <h3 class="text-lg font-bold text-white">🚚 Entrega</h3>
                </div>
                <div class="p-4 min-h-96 bg-gray-50">
                    <% const entrega = orders.filter(o => o.status === 'Entrega'); %>
                    <% if (entrega.length === 0) { %>
                        <div class="flex items-center justify-center h-full text-gray-400">
                            <p class="text-sm">Nenhum pedido</p>
                        </div>
                    <% } else { %>
                        <div class="space-y-3">
                            <% entrega.forEach(order => { %>
                                <div class="bg-white p-4 rounded-lg border-l-4 border-purple-400 shadow-sm hover:shadow-md transition" data-order-id="<%= order.id %>">
                                    <div class="font-bold text-gray-800 mb-2"><%= order.customer_name %></div>
                                    <div class="text-xs text-gray-600 mb-3 p-2 bg-gray-50 rounded">
                                        <%= order.item_names %>
                                    </div>
                                    <button onclick="advanceStatus(<%= order.id %>, 'Entrega')" class="w-full bg-purple-500 hover:bg-purple-600 text-white font-semibold text-sm py-2 rounded transition transform hover:scale-105">
                                        → Entregue
                                    </button>
                                </div>
                            <% }) %>
                        </div>
                    <% } %>
                </div>
            </div>

            <!-- Coluna: Entregue -->
            <div class="flex-shrink-0 w-80 bg-white rounded-xl shadow-md overflow-hidden">
                <div class="bg-gradient-to-r from-green-400 to-green-500 px-6 py-4">
                    <h3 class="text-lg font-bold text-white">✅ Entregue</h3>
                </div>
                <div class="p-4 min-h-96 bg-gray-50">
                    <% const entregue = orders.filter(o => o.status === 'Entregue'); %>
                    <% if (entregue.length === 0) { %>
                        <div class="flex items-center justify-center h-full text-gray-400">
                            <p class="text-sm">Nenhum pedido</p>
                        </div>
                    <% } else { %>
                        <div class="space-y-3">
                            <% entregue.forEach(order => { %>
                                <div class="bg-white p-4 rounded-lg border-l-4 border-green-400 shadow-sm" data-order-id="<%= order.id %>">
                                    <div class="font-bold text-gray-800 mb-2"><%= order.customer_name %></div>
                                    <div class="text-xs text-gray-600 p-2 bg-gray-50 rounded">
                                        <%= order.item_names %>
                                    </div>
                                    <div class="mt-3 text-center text-xs text-green-600 font-semibold">
                                        ✓ Pedido entregue
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>

    <script>
        async function advanceStatus(orderId, currentStatus) {
            const statusMap = {
                'Aberto': 'Cozinha',
                'Cozinha': 'Entrega',
                'Entrega': 'Entregue'
            };

            const nextStatus = statusMap[currentStatus];
            if (!nextStatus) return;

            try {
                const response = await fetch(`/orders/${orderId}/status`, {
                    method: 'PUT',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ status: nextStatus })
                });

                if (response.ok) {
                    // Animação suave
                    const card = document.querySelector(`[data-order-id="${orderId}"]`);
                    card.style.opacity = '0.5';
                    setTimeout(() => location.reload(), 300);
                } else {
                    alert('Erro ao atualizar o pedido.');
                }
            } catch (error) {
                alert('Erro ao atualizar o pedido.');
            }
        }
    </script>
</body>
</html>
