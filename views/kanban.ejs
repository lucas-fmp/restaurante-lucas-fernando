<div class="space-y-6">
    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
        <div>
            <h1 class="text-3xl font-bold mb-2">Cozinha</h1>
            <p class="text-muted-foreground">Gerencie os pedidos em tempo real via Kanban</p>
        </div>
        <button onclick="window.location.reload()" class="inline-flex items-center justify-center whitespace-nowrap text-sm font-medium transition-colors bg-secondary text-secondary-foreground hover:bg-secondary/80 h-10 px-4 py-2 rounded-xl gap-2">
            <i data-lucide="refresh-cw" class="w-4 h-4"></i> Atualizar
        </button>
    </div>

    <% const columns = [
        { id: 'Aberto', label: 'Novo Pedido', color: 'bg-blue-500/10 text-blue-500 ring-blue-500' },
        { id: 'Cozinha', label: 'Em Preparo', color: 'bg-accent/10 text-accent ring-accent' },
        { id: 'Entrega', label: 'Pronto / Entrega', color: 'bg-primary/10 text-primary ring-primary' },
        { id: 'Entregue', label: 'Finalizado', color: 'bg-success/10 text-success ring-success' }
    ]; %>

    <div class="flex gap-4 overflow-x-auto pb-4 h-[calc(100vh-12rem)]">
        <% columns.forEach(col => { %>
            <div class="flex-1 min-w-[320px] max-w-[350px] bg-card border border-border rounded-2xl flex flex-col kanban-column" data-status="<%= col.id %>">
                <div class="p-4 border-b border-border flex items-center justify-between">
                    <h3 class="font-bold text-sm"><%= col.label %></h3>
                    <span class="text-xs font-semibold px-2 py-1 rounded-md <%= col.color.split(' ')[0] %> <%= col.color.split(' ')[1] %>">
                        <%= orders.filter(o => o.status === col.id).length %>
                    </span>
                </div>
                <div class="p-4 flex-1 overflow-y-auto space-y-4 kanban-dropzone">
                    <% orders.filter(o => o.status === col.id).forEach(order => { %>
                        <div class="bg-background border border-border/50 rounded-xl p-4 shadow-sm cursor-move hover:border-primary/50 transition kanban-card" draggable="true" data-id="<%= order.id %>">
                            <div class="flex justify-between items-start mb-2">
                                <div class="font-bold">#<%= order.id %></div>
                                <div class="text-xs text-muted-foreground flex items-center gap-1">
                                    <i data-lucide="clock" class="w-3 h-3"></i> <%= new Date(order.created_at).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) %>
                                </div>
                            </div>
                            <div class="flex items-center gap-2 mb-3">
                                <div class="w-6 h-6 rounded-full bg-primary/10 text-primary flex items-center justify-center text-[10px] font-bold">
                                    <%= order.customer_name.charAt(0).toUpperCase() %>
                                </div>
                                <div class="text-sm font-medium truncate"><%= order.customer_name %></div>
                            </div>
                            <div class="text-xs text-muted-foreground">
                                <% if(order.item_names) { %>
                                    <% order.item_names.split(', ').forEach(item => { %>
                                        <div class="truncate">• <%= item %></div>
                                    <% }) %>
                                <% } %>
                            </div>
                        </div>
                    <% }) %>
                    <% if(orders.filter(o => o.status === col.id).length === 0) { %>
                        <div class="text-center py-8 text-muted-foreground opacity-50">
                            <p class="text-sm">Vazio</p>
                        </div>
                    <% } %>
                </div>
            </div>
        <% }) %>
    </div>
</div>

<script>
    const cards = document.querySelectorAll('.kanban-card');
    const dropzones = document.querySelectorAll('.kanban-column');

    cards.forEach(card => {
        card.addEventListener('dragstart', () => {
            card.classList.add('opacity-50');
            card.setAttribute('data-dragging', 'true');
        });
        card.addEventListener('dragend', () => {
            card.classList.remove('opacity-50');
            card.removeAttribute('data-dragging');
        });
    });

    dropzones.forEach(zone => {
        zone.addEventListener('dragover', e => {
            e.preventDefault();
            zone.classList.add('bg-muted/50');
        });
        zone.addEventListener('dragleave', () => {
            zone.classList.remove('bg-muted/50');
        });
        zone.addEventListener('drop', e => {
            e.preventDefault();
            zone.classList.remove('bg-muted/50');
            const card = document.querySelector('[data-dragging="true"]');
            if (card) {
                zone.querySelector('.kanban-dropzone').appendChild(card);
                const orderId = card.getAttribute('data-id');
                const newStatus = zone.getAttribute('data-status');
                
                fetch(`/api/orders/${orderId}/status`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ status: newStatus })
                }).then(res => {
                    if(res.ok) {
                        showToast(`Pedido #${orderId} atualizado para ${newStatus}`, 'success');
                    } else {
                        showToast('Erro ao atualizar pedido', 'error');
                    }
                }).catch(() => showToast('Erro de conexão', 'error'));
            }
        });
    });
</script>
